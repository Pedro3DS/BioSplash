  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A Expo Geek 2026 \xE9 um evento geek realizado no Mato Grosso do Sul,
    organizado em parceria com a ACJOGOSMS (Associa\xE7\xE3o de Criadores de Jogos
    do MS), que promove uma Game Jam com o objetivo de fomentar o desenvolvimento
    de jogos locais e integrar a comunidade criativa do estado. O tema desta edi\xE7\xE3o
    \xE9 o Bioparque Pantanal.\r\n\r\nInaugurado em mar\xE7o de 2022 em Campo Grande
    (MS), o Bioparque Pantanal \xE9 o maior aqu\xE1rio de \xE1gua doce do mundo!
    Um complexo de 19 mil metros quadrados com quase 5 milh\xF5es de litros de \xE1gua,
    constru\xEDdo para tornar o ecossistema do Pantanal acess\xEDvel \xE0s pessoas
    e celebrar a riqueza ambiental do Mato Grosso do Sul.\r\n\r\nEm BioSplash, voc\xEA
    e seu colega atuam como cientistas em um laborat\xF3rio de conserva\xE7\xE3o.
    Cada esp\xE9cime precisa ser registrada, identificada no computador e s\xE3o
    colocadas em tanques tempor\xE1rios. Assim que um macho e uma f\xEAmea da mesma
    esp\xE9cie forem catalogados, os dois precisam ser reunidos em um tanque de reprodu\xE7\xE3o.
    Ap\xF3s o processo, deve-se levar os filhotes ao tanque final para serem levados
    ao Bioparque Pantanal!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d5e93fa7927ba8444adc442c4d9ca32b, type: 2}
